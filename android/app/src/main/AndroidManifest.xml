<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false: remembered decryption keys live in filesDir/keys/
         and must never end up in a cloud backup (contract §6). -->
    <application
        android:name=".BoardviewApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Boardview">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" from file managers (contract §6). Two filters:

                 1. Name-pattern filter (below): matches when the file name is
                    in the URI path — file:// URIs, and content:// URIs
                    whose document id embeds the path (e.g. the
                    ExternalStorageProvider's "primary:Download/x.tvw").
                    Covers .tvw .fz .pcb .cad .brd .brd2 .bv .asc.
                    pathPattern globs are non-greedy, so each extension gets
                    extra-dot variants to match names like "rev1.01.tvw".
                    (.asc: a lone member of a directory-shaped eM-Test set
                    cannot parse alone; MainActivity shows a hint that routes
                    to the folder picker.)
                    Because the filter declares a mimeType, it matches only
                    when the intent carries a type: the resolver infers one
                    from the provider for content:// URIs (ContentResolver
                    .getType), but a file:// intent needs the sender to set
                    it (file managers normally do). A type-less VIEW intent,
                    or a provider whose getType returns null, matches neither
                    filter. No separate type-less or pathPattern-less file://
                    twin is declared: apps targeting API 24+ cannot expose
                    file:// URIs at all (FileUriExposedException), so that
                    route is legacy, and a file:// path always ends in the
                    file name, which filter 1 already matches.

                 2. Opaque-id filter (further below): the Downloads root
                    (msf:<id>), Google Drive, Chrome/Discord/Telegram
                    downloads and many file managers hand out content://
                    URIs with an opaque document id, so no pathPattern can
                    match. Extensions the system has no MIME mapping for
                    (.tvw .fz .pcb .cad .brd .brd2 .bv) are typed
                    application/octet-stream; we accept that MIME type for
                    any content:// URI and MainActivity.handleIncomingUri
                    gates on the DISPLAY_NAME extension instead (unsupported
                    extension -> error, no copy/parse; no extension at all ->
                    the parser content-sniffs). Known gaps: .asc has a
                    MimeTypeMap mapping, so it is not typed octet-stream and
                    an opaque-id .asc is not offered — moot, since a lone .asc only ever shows the
                    folder hint; and a sender that supplies some other type
                    (application/zip, a vendor type) is not matched either.
                    Side effect: the chooser lists Boardview for EVERY
                    opaque-id binary; a user who picks "Always" makes it the
                    default for all of them and must clear it under
                    Settings > Apps > Boardview > Open by default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.tvw" />
                <data android:pathPattern=".*\\..*\\.tvw" />
                <data android:pathPattern=".*\\..*\\..*\\.tvw" />
                <data android:pathPattern=".*\\.fz" />
                <data android:pathPattern=".*\\..*\\.fz" />
                <data android:pathPattern=".*\\..*\\..*\\.fz" />
                <data android:pathPattern=".*\\.pcb" />
                <data android:pathPattern=".*\\..*\\.pcb" />
                <data android:pathPattern=".*\\..*\\..*\\.pcb" />
                <data android:pathPattern=".*\\.cad" />
                <data android:pathPattern=".*\\..*\\.cad" />
                <data android:pathPattern=".*\\..*\\..*\\.cad" />
                <data android:pathPattern=".*\\.brd" />
                <data android:pathPattern=".*\\..*\\.brd" />
                <data android:pathPattern=".*\\..*\\..*\\.brd" />
                <data android:pathPattern=".*\\.brd2" />
                <data android:pathPattern=".*\\..*\\.brd2" />
                <data android:pathPattern=".*\\..*\\..*\\.brd2" />
                <data android:pathPattern=".*\\.bv" />
                <data android:pathPattern=".*\\..*\\.bv" />
                <data android:pathPattern=".*\\..*\\..*\\.bv" />
                <data android:pathPattern=".*\\.asc" />
                <data android:pathPattern=".*\\..*\\.asc" />
                <data android:pathPattern=".*\\..*\\..*\\.asc" />
            </intent-filter>

            <!-- Filter 2 (see the comment above): opaque-id content://
                 documents typed application/octet-stream. Deliberately no
                 host or pathPattern — the name is not in the URI; the
                 extension gate lives in MainActivity.handleIncomingUri. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Standalone key-management screen, launched from the viewer
             toolbar (BoardviewBridge.openKeyManager). Not exported. -->
        <activity
            android:name=".KeyManagerActivity"
            android:exported="false"
            android:label="@string/key_manager_title"
            android:parentActivityName=".MainActivity" />

        <!-- Read-only third-party license viewer, reachable from the
             key-management screen's footer. Not exported. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_title"
            android:parentActivityName=".KeyManagerActivity" />
    </application>
</manifest>
